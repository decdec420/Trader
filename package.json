{
  "name": "crypto-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts bot:status",
    "bot:status": "tsx src/cli/index.ts bot:status",
    "bot:scan": "tsx src/cli/index.ts bot:scan",
    "bot:research": "tsx src/cli/index.ts bot:research",
    "bot:paper": "tsx src/cli/index.ts bot:paper",
    "bot:learn": "tsx src/cli/index.ts bot:learn",
    "bot:live": "tsx src/cli/index.ts bot:live",
    "bot:journal": "tsx src/cli/index.ts bot:journal",
    "bot:promote": "tsx src/cli/index.ts bot:promote",
    "bot:summary": "tsx src/cli/index.ts bot:summary"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
